{
  "name": "only-learn",
  "version": "0.1.0",
  "private": true,
  "description": "Catatan riset di balik setiap reel @only_learn0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run cek && next build",
    "start": "next start",
    "cek": "tsx --conditions=import scripts/cek.ts",
    "baru": "tsx --conditions=import scripts/baru.ts",
    "impor": "tsx --conditions=import scripts/impor.ts",
    "reel": "tsx --conditions=import scripts/reel.ts",
    "schema": "tsx scripts/schema.ts",
    "tokens": "design.md lint DESIGN.md && design.md export DESIGN.md --format css-tailwind > src/styles/tokens.css",
    "test": "tsx --conditions=import --test src/lib/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
