# URL produksi blog (dipakai untuk sitemap, canonical, dan OG image)
NEXT_PUBLIC_SITE_URL=https://onlylearn0.vercel.app

# true = tampilkan catatan draft (pakai hanya di Preview Vercel, jangan di Production)
SHOW_DRAFTS=false

# Kunci API Resend untuk form langganan email. Kosong = form menjawab "Langganan belum aktif"
# Sebelum mengisi kunci: pasang aturan rate limit Vercel Firewall untuk POST /api/langganan (20 request/menit per IP, aksi rate limit 429, lalu publish). Lihat docs/04-deploy.md
RESEND_API_KEY=

# ID segment Resend tempat kontak baru dimasukkan (opsional)
RESEND_SEGMENT_ID=
